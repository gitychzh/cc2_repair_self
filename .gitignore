# Track gateway_backup/ and gateway_backup.* snapshot trees in this repo.
# Also track task definition (CLAUDE.md) and run state (STATE.md).
# Ignore everything else (agent working files, session jsonl, bak files, tmp logs).
*
!/.gitignore
!/gateway_backup/
!/gateway_backup/**
!/gateway_backup.cc_s3/
!/gateway_backup.cc_s3/**
!/README_BACKUP.md
!/CLAUDE.md
!/STATE.md
!/specs/
!/specs/**
